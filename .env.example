# Скопируйте файл и подставьте свои значения:
#   cp .env.example .env

# HTTP-сервер
PORT=8080
HOST=0.0.0.0

# Время жизни cookie в минутах
COOKIE_TTL=10

# Адреса gRPC-сервисов (имена контейнеров в docker-compose)
AUTH_HOST=auth-service
AUTH_PORT=50051
APITOKEN_HOST=api-tokens-service
APITOKEN_PORT=50052
VIDEO_HOST=video-service
VIDEO_PORT=50053
