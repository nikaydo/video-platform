# Шаблон конфигурации. Скопируйте его в .env и подставьте реальные значения:
#
#   cp .env.example .env
#
# Приложение проверяет конфигурацию при старте и не запустится при
# некорректных значениях. Порты сервисов должны различаться.

# ─────────────────────────────────────────────────────────────────────────────
# HTTP-сервер
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# Каталог со статикой (index.html, register.html, user.html).
STATIC_DIR=web

# ─────────────────────────────────────────────────────────────────────────────
# Адреса сервисов
# ─────────────────────────────────────────────────────────────────────────────
# В Docker Compose используются имена сервисов, локально — localhost.
AUTH_HOST=auth-service
AUTH_PORT=50051

TOKEN_HOST=api-tokens-service
TOKEN_PORT=50052

VIDEO_HOST=video-service
VIDEO_PORT=50053

# ─────────────────────────────────────────────────────────────────────────────
# Сессия
# ─────────────────────────────────────────────────────────────────────────────
COOKIE_NAME=jwt

# Сессия держится дольше access-токена: она продлевается автоматически
# через refresh-токен, поэтому cookie не исчезает вместе с ним.
SESSION_TTL=24h

# COOKIE_SECURE=true отправляет cookie только по HTTPS. Оставьте false при
# локальной разработке по http, иначе cookie не сохранится.
#
# Заголовки безопасности (CSP и прочие) включаются только вместе с этим флагом:
# иначе приложение, доступное по http, получит cookie, которые браузер
# не отправит.
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# Ограничения
# ─────────────────────────────────────────────────────────────────────────────
# Предел тела запроса в байтах (25 МиБ).
MAX_REQUEST_BYTES=26214400

# Предел размера одного видеофайла в байтах (20 МиБ). Должен быть не больше
# MAX_REQUEST_BYTES.
MAX_UPLOAD_BYTES=20971520

# Предел суммарного времени обработки запроса.
REQUEST_TIMEOUT=60s

# Таймаут одного вызова gRPC. Без него запрос к зависшему сервису держал бы
# HTTP-соединение до конца соединения клиента.
GRPC_TIMEOUT=30s

# Ожидание завершения текущих запросов при остановке.
SHUTDOWN_TIMEOUT=30s

# Сколько попыток входа и регистрации разрешено с одного адреса за окно.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m