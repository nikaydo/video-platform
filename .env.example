# Шаблон конфигурации. Скопируйте его в .env и подставьте реальные значения:
#
#   cp .env.example .env
#
# Приложение проверяет конфигурацию при старте и не запустится при
# некорректных значениях.

# ─────────────────────────────────────────────────────────────────────────────
# HTTP-сервер
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Адреса gRPC-сервисов
# ─────────────────────────────────────────────────────────────────────────────
# В docker-compose используются имена контейнеров, локально — localhost.
AUTH_HOST=auth-service
AUTH_PORT=50051

TOKEN_HOST=api-tokens-service
TOKEN_PORT=50052

VIDEO_HOST=video-service
VIDEO_PORT=50053

# ─────────────────────────────────────────────────────────────────────────────
# Сессия
# ─────────────────────────────────────────────────────────────────────────────
COOKIE_NAME=jwt

# COOKIE_SECURE=true отправляет cookie только по HTTPS. Оставьте false при
# локальной разработке по http, иначе cookie не сохранится.
# Заголовки безопасности включаются вместе с этим флагом.
COOKIE_SECURE=false

# Сколько живёт cookie сессии. Сама сессия продлевается ротацией
# refresh-токена, поэтому cookie не должна исчезать вместе с access-токеном.
SESSION_TTL=24h

# ─────────────────────────────────────────────────────────────────────────────
# Ограничения
# ─────────────────────────────────────────────────────────────────────────────
# Предел тела запроса в байтах. Загрузка видео идёт через multipart,
# поэтому значение должно быть заметно больше MAX_UPLOAD_BYTES.
MAX_REQUEST_BYTES=26214400

# Предел размера одного видеофайла в байтах. Не может превышать
# MAX_REQUEST_BYTES — иначе проверка тела обрежет файл раньше срока.
MAX_UPLOAD_BYTES=20971520

# Сколько попыток входа и регистрации разрешено с одного адреса.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m

# ─────────────────────────────────────────────────────────────────────────────
# Таймауты
# ─────────────────────────────────────────────────────────────────────────────
# Суммарное время обработки HTTP-запроса.
REQUEST_TIMEOUT=60s

# Таймаут одного вызова gRPC. Без него запрос к зависшему сервису держал бы
# HTTP-соединение до конца соединения клиента.
GRPC_TIMEOUT=30s

# Сколько ждать завершения текущих запросов при остановке.
SHUTDOWN_TIMEOUT=30s

# ─────────────────────────────────────────────────────────────────────────────
# Статика
# ─────────────────────────────────────────────────────────────────────────────
STATIC_DIR=web